{
  "name": "@vep/server",
  "version": "0.1.0",
  "private": true,
  "description": "API server: projects, media library, media processing and the FFmpeg-backed render farm.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --exclude ./data src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "benchmark": "tsx src/scripts/benchmark.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^10.1.6",
    "@napi-rs/canvas": "^1.0.11",
    "@vep/core": "*",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
  }
}
