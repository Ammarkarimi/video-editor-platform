# Server (apps/server). All variables are optional.
HOST=127.0.0.1
PORT=3001
# Where the database, uploads, previews and exports are stored.
DATA_DIR=./data
# FFmpeg binaries (must include libx264, libvpx-vp9, libopus, libmp3lame).
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_UPLOAD_MB=4096
# Media processing jobs (thumbnails, waveforms, proxies) running at once.
MEDIA_CONCURRENCY=2
# Export jobs running at once, and worker processes per export.
RENDER_CONCURRENCY=1
RENDER_WORKERS=2
# Preview proxies: h264 (default) or vp9; PROXY_ALWAYS=1 proxies every video/audio file.
PROXY_CODEC=h264
PROXY_ALWAYS=0
# Comma-separated origins allowed to call the API from another host (not needed with the Vite proxy).
CORS_ORIGIN=
LOG_LEVEL=info
# Built web app to serve (auto-detected from apps/web/dist).
PUBLIC_DIR=
# Bundled fonts (auto-detected from assets/fonts).
FONTS_DIR=
